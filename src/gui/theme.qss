/* 浅蓝工作空间：统一字体、状态、尺寸节奏，业务行为由原页面负责。 */
QWidget { font-family: "Microsoft YaHei"; font-size: 13px; font-weight: 400; color: #26364A; }
QMainWindow, QStackedWidget, QScrollArea { background: #F2F6FC; }
QWidget#loginSurface, QWidget#accountPage, QWidget#friendsPage, QWidget#groupsPage { background: #F2F6FC; }
QLabel { background: transparent; }
QLabel[muted="true"], QLabel#accountIdentity { color: #646C79; font-size: 12px; }
QLabel#brand { font-size: 23px; font-weight: bold; color: #1C3964; }
QLabel#workspaceTitle { font-size: 13px; font-weight: 400; color: #495363; }
QLabel#pageTitle { font-size: 24px; font-weight: bold; padding: 4px 0; color: #1E2A3D; }
QLabel[cardHeading="true"] { font-size: 16px; font-weight: bold; padding: 0 0 10px 0; border: none; border-bottom: 1px solid #E5E9EE; }
QLabel#chatPeerTitle, QLabel#groupChatTitle { border: none; padding: 0; font-size: 17px; }

/* 主导航、服务切换和页内标签分别承担三个层次。 */
QFrame#sidebar { background: #E2EBF8; border-right: 1px solid #D0D7E1; }
QPushButton[navigation="true"] { text-align: left; font-size: 16px; font-weight: 400; padding: 12px 14px; border: 1px solid #B7CDED; border-radius: 9px; background: transparent; }
QPushButton[navigation="true"]:hover { background: #D1D8E3; }
QPushButton[navigation="true"]:checked { color: #152F57; background: #D1E2FA; border-left: 3px solid #254980; padding-left: 12px; }
QPushButton[navigation="true"]:disabled { background: transparent; color: #89909B; border-color: #B7CDED; }
QPushButton[navigation="true"]:checked:disabled { border-left-color: #254980; }
QTabWidget::pane { border: none; background: transparent; }
QTabWidget QStackedWidget { background: transparent; }
QTabBar::tab { min-width: 60px; padding: 9px 16px; margin: 0 6px 8px 0; border: 1px solid #D3D8E0; border-radius: 8px; background: #EAEDF1; color: #56606F; }
QTabBar::tab:selected { background: #FCFDFF; color: #173767; border-color: #7085A5; }
QTabBar::tab:hover:!selected { background: #E0E5EC; border-color: #A2AEBF; }
QTabWidget#loginTabs QTabBar::tab { width: 76px; padding: 8px 0; }
/* 文字与角标分别留足空间；底部不用外边距，保持角标垂直居中。 */
QTabWidget#messageTabs QTabBar::tab { width: 100px; padding: 8px 12px; margin: 0 6px 0 0; }
QTabWidget#friendTabs QTabBar::tab { min-width: 106px; padding: 8px 12px; }
QTabWidget#groupTabs QTabBar::tab { width: 92px; min-width: 0; padding: 8px 0; margin-right: 4px; font-size: 12px; }

/* 轻玻璃卡片：背景保持可读，阴影由 CardSurfaceLJY 统一绘制。 */
QFrame[surfaceCard="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0.15, y2:1,
        stop:0 rgba(255,255,255,252), stop:0.65 rgba(252,253,255,247), stop:1 rgba(242,246,252,243));
    border: 1px solid #DCE0E7; border-top-color: #ffffff; border-radius: 14px;
}
QFrame[surfaceCard="true"] QListWidget, QFrame[surfaceCard="true"] QTableWidget,
QFrame[surfaceCard="true"] QPlainTextEdit { background: transparent; }

/* 按钮的高度与同组宽度由 ActionStyleLJY 设置，颜色只表达操作层级。 */
QPushButton { padding: 8px 12px; border: 1px solid #CAD7E8; border-radius: 8px; background: #FCFDFF; color: #313F53; }
QPushButton[sizedAction="true"] { padding: 0 10px; }
QPushButton:hover { background: #EDF0F5; border-color: #8394AE; }
QPushButton:pressed { background: #DBE2EC; }
QPushButton:focus { border-color: #254980; }
QPushButton:checked { color: #1D3963; background: #DFEBFC; border-color: #8395B0; }
QPushButton[primary="true"] { color: white; background: #3675D3; border-color: #3675D3; font-weight: 400; }
QPushButton[primary="true"]:hover { background: #2862BB; border-color: #2862BB; }
QPushButton[primary="true"]:pressed { background: #2053A3; }
QPushButton[coral="true"] { color: white; background: #d85d6b; border-color: #d85d6b; }
QPushButton[coral="true"]:hover { background: #c8505e; border-color: #c8505e; }
QPushButton[coral="true"]:pressed { background: #b74452; }
QPushButton[danger="true"] { color: #a64251; background: #fff6f7; border-color: #ebc9cf; }
QPushButton[danger="true"]:hover { background: #fce8ec; border-color: #d99aa6; }
QPushButton:disabled, QPushButton[primary="true"]:disabled, QPushButton[coral="true"]:disabled,
QPushButton[danger="true"]:disabled { color: #8C929B; background: #EDEFF2; border-color: #DDE1E6; }
QPushButton[compact="true"], QPushButton[friendAction="true"] { font-size: 12px; }
QPushButton#bindButton:enabled { background: #E3E9F2; color: #253F67; border-color: #B6C2D5; }

/* 表单统一行高；焦点与悬停只变颜色，避免边框宽度变化引起抖动。 */
QLineEdit, QComboBox, QSpinBox { padding: 0 10px; border: 1px solid #CAD7E8; border-radius: 8px; background: #F9FAFC; selection-background-color: #3675D3; selection-color: white; }
QLineEdit:hover, QComboBox:hover, QSpinBox:hover { border-color: #9BA8BB; }
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #365789; background: white; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled { color: #878E99; background: #EDEFF2; border-color: #DDE1E6; }
QComboBox { padding-right: 28px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 26px; border: 0; background: transparent; }
QComboBox::down-arrow { image: url(:/gui/chevron.xpm); width: 9px; height: 5px; }
QComboBox QAbstractItemView { background: white; border: 1px solid #CAD7E8; selection-background-color: #DFEBFC; selection-color: #25344A; padding: 4px; }
QSpinBox#chatPort, QSpinBox#groupChatPort { min-width: 56px; }
QPlainTextEdit { padding: 8px; border: 1px solid #D5DAE2; border-radius: 8px; selection-background-color: #3675D3; }
QPlainTextEdit:focus { border-color: #365789; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #AAB5C5; border-radius: 4px; background: white; }
QCheckBox::indicator:checked { background: #3675D3; border-color: #3675D3; }

/* 列表和表格用柔和选中行与清晰表头，去掉单元格网格线。 */
QTableWidget, QListWidget { background: white; alternate-background-color: #F4F6F8; border: 1px solid #DCE0E7; border-radius: 8px; gridline-color: #E8EAEE; outline: none; }
QHeaderView::section { background: #EDF0F4; color: #535E6E; padding: 9px 6px; border: none; font-size: 12px; }
QListWidget::item { padding: 12px 10px; border: none; border-bottom: 1px solid #EDEFF3; }
QListWidget::item:hover { background: #EEF1F5; }
QListWidget::item:selected, QTableWidget::item:selected { background: #DFEBFC; color: #1D3457; }
QTableWidget#servicesTable, QListWidget#friendsList, QListWidget#friendQueryResults,
QPlainTextEdit#friendQueryReasons, QListWidget#friendRequestsList, QListWidget#groupsList,
QTableWidget#groupMembers, QTableWidget#groupRequests, QListWidget#subgroupsList,
QListWidget#subgroupMembers, QListWidget#chatFriends, QListWidget#chatGroups { border: none; }
QListWidget#subgroupMembers::item { padding: 7px; }
/* 子群名单使用列表指示器，单独指定各状态，避免原生主题绘制成黑块。 */
QListWidget#subgroupMembers::indicator { width: 16px; height: 16px; border: 1px solid #AAB5C5; border-radius: 4px; background: #FCFDFF; image: none; }
QListWidget#subgroupMembers::indicator:unchecked:hover { background: #EEF1F6; border-color: #3675D3; }
QListWidget#subgroupMembers::indicator:checked { background: #3675D3; border-color: #3675D3; image: url(:/gui/check.xpm); }
QListWidget#subgroupMembers::indicator:checked:disabled { background: #9BA7B9; border-color: #9BA7B9; image: url(:/gui/check.xpm); }
QListWidget#subgroupMembers::indicator:unchecked:disabled { background: #EDEFF3; border-color: #CFD5DD; }

QListWidget#chatFriends::item { padding: 0; border: none; border-radius: 8px; }
QLabel#groupSummary { font-size: 16px; font-weight: bold; }
QLabel#friendNickname { font-size: 20px; font-weight: bold; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px 0; }
QScrollBar::handle:vertical { background: #BFC5CE; border-radius: 4px; min-height: 32px; }
QScrollBar::handle:vertical:hover { background: #909CAD; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { height: 8px; background: transparent; }
QScrollBar::handle:horizontal { background: #BFC5CE; border-radius: 4px; min-width: 32px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* 登录与身份：头像六色保持原值，白色身份卡与侧栏区分。 */
QLabel#welcomeEyebrow { color: #3675D3; font-size: 13px; font-weight: bold; }
QLabel#welcomeHeadline { font-size: 29px; font-weight: bold; color: #1E2C40; }
QLabel#welcomeDescription { font-size: 14px; color: #606B7B; }
QLabel#serviceBadge { background: #E0E5EC; border: 1px solid #D4DBE5; border-radius: 12px; padding: 15px 10px; color: #2B456C; }
QLabel#accountAvatar { border-radius: 38px; font-size: 32px; font-weight: bold; }
QLabel#friendAvatar, QLabel#sidebarAvatar { border-radius: 28px; font-size: 25px; font-weight: bold; }
QPushButton#sidebarProfileButton { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:1 #F9FAFC); border: 1px solid #D6DCE5; border-top-color: white; border-radius: 14px; padding: 0; }
QPushButton#sidebarProfileButton:hover { border-color: #96A4BA; background: #FCFDFF; }
QPushButton#sidebarProfileButton:disabled { background: #F8F9FB; border-color: #D6DCE5; }
QLabel#sidebarNickname { font-size: 17px; font-weight: bold; }
QLabel#sidebarNumber { font-size: 11px; color: #6C7481; }
QLabel#databasePath { font-size: 11px; color: #747C89; }

/* 内置确认保持等宽按钮；固定错误条由 UiFeedbackLJY 保留原尺寸和震动。 */
QWidget#inlineDialog { background: rgba(26,36,52,90); }
QFrame#dialogCard { background: #FCFDFF; border: 1px solid #D2D9E4; border-radius: 16px; }
QLabel#dialogTitle { font-size: 20px; font-weight: bold; }
QLabel#dialogMessage { background: transparent; color: #535D6B; font-size: 14px; padding: 0; }
QToolTip { color: #ffffff; background: #29364A; border: none; border-radius: 5px; padding: 6px 9px; }

/* 私聊、群聊使用相同的会话背景、头像、正文和输入区。 */
QWidget#chatTimeline, QWidget#groupChatTimeline, QFrame#chatBubble, QFrame#groupChatBubble { background: transparent; border: none; }
QScrollArea#chatScroll, QScrollArea#groupChatScroll { background: #F2F6FC; border: none; border-radius: 10px; }
QWidget#chatConnectionPanel { background: #F2F4F7; border-radius: 10px; }
QLabel#chatBody, QLabel#groupChatBody { background: transparent; border: none; color: #202C3D; font-size: 14px; padding: 0; }
QLabel#chatDelivery, QLabel#groupSender, QLabel#groupStamp { background: transparent; border: none; font-size: 11px; padding: 0; }
QPlainTextEdit#chatEditor, QPlainTextEdit#groupChatEditor { border: 1px solid #C7CFDC; border-radius: 10px; background: #FCFDFF; padding: 10px; }
QPlainTextEdit#chatEditor:focus, QPlainTextEdit#groupChatEditor:focus { border-color: #365789; }
QLabel#chatAvatar { border-radius: 20px; font-size: 18px; font-weight: bold; }
QLabel#chatSenderAvatar { border: none; border-radius: 18px; font-size: 16px; font-weight: bold; padding: 0; }
QLabel#chatFriendAvatar { border: none; border-radius: 16px; font-size: 15px; font-weight: bold; }
QLabel#chatFriendText { background: transparent; padding: 0; }
QPushButton#chatFriendMore { padding: 0; border: none; border-radius: 8px; background: transparent; color: #536175; }
QPushButton#chatFriendMore:hover { background: #C9D3E3; }
QPushButton#chatFriendMore:focus { border: 1px solid #7889A3; }
QPushButton#chatExpand { padding: 0 4px; border: none; border-radius: 4px; background: transparent; color: #213D68; font-size: 12px; }
QPushButton#chatExpand:hover { background: #CED8E8; }
